<title>VIVA — Seu assistente para a vida</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);--bg:#f4f7ff;--card:#fff;--ink:#0f1b2d;--muted:#5d6b82;--g:#006b4f;--g2:#0b8a63;--mint:#69f6b8;--mint2:#dff9ee;--blue:#dbe6ff;--red:#c0392b;--redbg:#fde3df;--amber:#b7791f;--line:#e3e9f5;--r:18px}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
#app{max-width:480px;margin:0 auto;min-height:100vh;padding-bottom:110px;position:relative}
button{font:inherit;color:inherit;cursor:pointer}
input,select,textarea{font:inherit;color:var(--ink);padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:#fff;width:100%;min-width:0;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--g2)}
textarea{min-height:90px;resize:vertical}
.top{display:flex;align-items:center;gap:10px;padding:14px 18px;position:sticky;top:env(safe-area-inset-top,0px);background:rgba(244,247,255,.92);backdrop-filter:blur(8px);z-index:20}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:21}
.logo{font-weight:800;font-size:20px;letter-spacing:.5px}
.chip{font-size:11px;font-weight:700;background:var(--mint);color:#00513b;padding:3px 10px;border-radius:999px}
.sp{flex:1}
.ib{position:relative;width:38px;height:38px;border-radius:50%;border:0;background:#fff;font-size:17px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.dot{position:absolute;top:5px;right:5px;min-width:16px;height:16px;border-radius:9px;background:var(--g2);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center}
.av{background:var(--g);color:#fff;font-weight:700}
main{padding:0 16px}
h1{font-size:28px;margin:6px 0 4px;letter-spacing:-.5px;line-height:1.15}
h2{font-size:17px;margin:0}
.sub{color:var(--muted);font-size:14px;margin:0 0 14px}
.card{background:var(--card);border-radius:var(--r);padding:16px;margin-bottom:14px;box-shadow:0 1px 3px rgba(15,27,45,.06)}
.mintcard{background:linear-gradient(135deg,var(--mint2),#eaf1ff)}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.8px;color:var(--muted);text-transform:uppercase}
.sec{display:flex;align-items:center;justify-content:space-between;margin:20px 0 10px}
.link{background:none;border:0;color:var(--g);font-weight:700;font-size:13px;padding:0}
.pill{display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:var(--blue);color:#1f3a6e}
.pill.g{background:var(--mint);color:#00513b}.pill.r{background:var(--redbg);color:var(--red)}.pill.a{background:#fdeccb;color:var(--amber)}
.row{display:flex;gap:10px;align-items:center}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.btn{border:0;border-radius:999px;padding:13px 18px;font-weight:700;background:var(--g);color:#fff}
.btn.mint{background:var(--mint);color:#00513b}
.btn.soft{background:var(--blue);color:#1f3a6e}
.btn.dark{background:var(--ink);color:#fff}
.btn.sm{padding:8px 14px;font-size:13px}
.btn.block{width:100%}
.bar{height:9px;background:var(--blue);border-radius:99px;overflow:hidden;margin:8px 0}
.bar i{display:block;height:100%;background:var(--g);border-radius:99px;transition:width .3s}
.bar i.warn{background:#e0a21a}.bar i.over{background:var(--ink)}
.muted{color:var(--muted);font-size:13px}
.tabsx{display:flex;gap:8px;overflow-x:auto;padding:2px 0 10px;scrollbar-width:none}
.tabsx::-webkit-scrollbar{display:none}
.tb{border:0;background:var(--blue);color:#1f3a6e;padding:9px 16px;border-radius:999px;font-weight:600;font-size:13px;white-space:nowrap}
.tb.on{background:var(--ink);color:#fff}
.task{background:#fff;border-radius:16px;padding:14px;margin-bottom:10px;box-shadow:0 1px 3px rgba(15,27,45,.06)}
.task.done .tt{text-decoration:line-through;color:var(--muted)}
.tt{font-weight:700;overflow-wrap:anywhere}
.ck{width:26px;height:26px;border-radius:50%;border:2px solid #b9c7e6;background:#fff;flex:none;color:#fff;font-weight:800;font-size:14px;padding:0}
.done .ck{background:var(--g2);border-color:var(--g2)}
.x{background:none;border:0;font-size:20px;color:#9aa6bd;padding:0 4px}
.stat{background:#fff;border-radius:var(--r);padding:14px;box-shadow:0 1px 3px rgba(15,27,45,.06)}
.big{font-size:24px;font-weight:800;letter-spacing:-.5px}
.hero{background:linear-gradient(160deg,#101d33,#16263f);color:#fff;border-radius:24px;padding:18px;margin-bottom:14px}
.hero .big{font-size:36px}
.hero .box{background:rgba(255,255,255,.08);border-radius:16px;padding:10px 12px}
.shortcut{background:#fff;border:0;border-radius:16px;padding:12px 4px;text-align:center;box-shadow:0 1px 3px rgba(15,27,45,.06);font-size:12px;font-weight:600}
.shortcut div{width:40px;height:40px;border-radius:50%;background:var(--mint2);margin:0 auto 6px;display:flex;align-items:center;justify-content:center;font-size:19px}
.shortcut small{display:block;color:var(--muted);font-weight:500}
.empty{text-align:center;color:var(--muted);padding:20px;font-size:14px;background:#fff;border:1px dashed #c8d3ea;border-radius:16px;margin-bottom:10px}
.cap-in{background:#fff;border-radius:24px;padding:16px;box-shadow:0 1px 3px rgba(15,27,45,.06);margin-bottom:14px}
.seg{display:inline-flex;background:var(--blue);border-radius:999px;padding:4px}
.seg button{border:0;background:none;padding:7px 16px;border-radius:999px;font-weight:700;font-size:13px;color:#1f3a6e}
.seg button.on{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.12)}
.item{display:flex;gap:12px;align-items:center;background:#eaf1ff;border-radius:16px;padding:12px;margin-bottom:10px}
.item .ic{width:42px;height:42px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:19px;flex:none}
.item .gr{flex:1;min-width:0}
.item .v{font-weight:800;font-size:17px;color:var(--g)}
.ex{display:block;width:100%;text-align:left;border:0;background:#fff;padding:11px 14px;border-radius:999px;margin-bottom:8px;font-size:13px;font-weight:600;box-shadow:0 1px 3px rgba(15,27,45,.06)}
nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:#fff;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);padding:8px 4px calc(12px + env(safe-area-inset-bottom,0px));z-index:30;align-items:end}
nav button{background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;font-weight:600;color:var(--muted);padding:4px}
nav button span{font-size:20px}
nav button.on{color:var(--g)}
nav .fab span{width:56px;height:56px;border-radius:50%;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin-top:-30px;box-shadow:0 6px 16px rgba(0,107,79,.35);border:4px solid var(--bg)}
nav .fab.on{color:var(--g)}
.ov{position:fixed;inset:0;background:rgba(15,27,45,.45);z-index:50;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:#fff;width:100%;max-width:480px;border-radius:24px 24px 0 0;padding:18px 18px calc(28px + env(safe-area-inset-bottom,0px));max-height:88vh;overflow-y:auto}
.sheet form{display:grid;gap:10px;margin-top:12px}
.handle{width:42px;height:4px;background:#d0d8ea;border-radius:9px;margin:0 auto 12px}
#toast{position:fixed;left:50%;bottom:100px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:13px;font-weight:600;opacity:0;transition:.25s;z-index:80;pointer-events:none;max-width:90%;text-align:center}
#toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.timer{font-size:56px;font-weight:800;text-align:center;letter-spacing:-1px;margin:14px 0}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:14px}
.cols b{display:block;font-size:12px;color:var(--muted);margin-bottom:3px}
.pause{background:linear-gradient(135deg,#0b3d2e,#1b7a59);color:#fff;border-radius:20px;padding:18px;display:flex;align-items:center;gap:12px;margin-bottom:14px}
.red{color:var(--red);font-weight:700}.amber{color:var(--amber);font-weight:700}.green{color:var(--g);font-weight:700}
.mic{width:96px;height:96px;border-radius:50%;border:0;background:var(--mint);font-size:38px;display:block;margin:12px auto}
.mic.on{background:var(--red);color:#fff}
.auth{max-width:480px;margin:0 auto;padding:0 16px 40px}
.authhero{background:linear-gradient(160deg,#006b4f,#0b8a63);color:#fff;border-radius:0 0 28px 28px;padding:22px 18px 26px;margin:0 -16px 16px}
.authhero h1{font-size:26px;margin:12px 0 6px;color:#fff}
.authhero p{color:#d3ecdf;font-size:14px;margin:0;line-height:1.5}
.form{display:grid;gap:10px}
.hint{font-size:12px;color:var(--muted);line-height:1.5}
.safe{display:flex;gap:8px;align-items:flex-start;background:#e8f4ee;border-radius:14px;padding:12px;font-size:12.5px;color:#0b5a42;line-height:1.45;margin-bottom:14px}
.admrow{background:#fff;border-radius:16px;padding:14px;margin-bottom:10px;box-shadow:0 1px 3px rgba(15,27,45,.06)}
.admstats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.admstat{background:#fff;border-radius:16px;padding:14px;box-shadow:0 1px 3px rgba(15,27,45,.06)}
.admstat b{font-size:26px;display:block;letter-spacing:-.5px}
.step{display:flex;gap:12px;margin-bottom:14px}
.step i{width:28px;height:28px;border-radius:50%;background:var(--g);color:#fff;font-style:normal;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center;flex:none}
.step div b{display:block;font-size:14px;margin-bottom:2px}
.step div span{font-size:13px;color:var(--muted);line-height:1.45}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;background:var(--blue);padding:2px 7px;border-radius:8px}
.note{background:#fffaf0;border-left:3px solid var(--amber);border-radius:10px;padding:10px 12px;font-size:13px;color:#7a5410;margin-top:10px;line-height:1.5}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast"></div>
<script>
/* ===== Armazenamento seguro (cai para memória se o navegador bloquear) ===== */
(function(){try{localStorage.setItem('_t','1');localStorage.removeItem('_t')}catch(e){
  const m={};const sh={getItem:k=>k in m?m[k]:null,setItem:(k,v)=>{m[k]=String(v)},removeItem:k=>{delete m[k]}};
  try{Object.defineProperty(window,'localStorage',{value:sh,configurable:true})}catch(_){window.__ls=sh}
}})();
const LS=(()=>{try{return window.localStorage}catch(e){return window.__ls}})()||{getItem:()=>null,setItem:()=>{},removeItem:()=>{}};

/* ================= Utilidades ================= */
const $=s=>document.querySelector(s);
const p2=n=>String(n).padStart(2,'0');
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const cap=s=>{s=String(s||'').trim();return s?s[0].toUpperCase()+s.slice(1):''};
const moeda=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const nfmt=v=>Number(v).toLocaleString('pt-BR',{maximumFractionDigits:2});
const ds=d=>d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate());
const hoje=()=>ds(new Date());
function addDias(n,base){const d=base?new Date(base+'T12:00'):new Date();d.setDate(d.getDate()+n);return ds(d)}
const diff=(a,b)=>Math.round((new Date(b+'T12:00')-new Date(a+'T12:00'))/864e5);
const fmtD=s=>s?s.split('-').reverse().slice(0,2).join('/'):'';
const DIAS=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2800)}

/* ================= Contas, senhas e sessão ================= */
const UKEY='viva-users',SKEY='viva-sessao',ADMIN_SENHA='232108',PKEY='viva-admpw';
const admPw=()=>LS.getItem(PKEY)||ADMIN_SENHA;
const slug=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
const uLoad=()=>{try{return JSON.parse(LS.getItem(UKEY))||{}}catch(e){return{}}};
const uSave=o=>{try{LS.setItem(UKEY,JSON.stringify(o))}catch(e){}};
const KEY=()=>'viva-v2:'+(sess||'anon');
let sess=LS.getItem(SKEY);
function statusUser(u){
  if(!u)return'inexistente';
  if(u.bloqueado)return'bloqueado';
  if(u.fim&&hoje()>u.fim)return'expirado';
  if(u.ini&&hoje()<u.ini)return'aguardando';
  return'ativo';
}
const STL={ativo:['Acesso ativo','g'],bloqueado:['Bloqueado','r'],expirado:['Período encerrado','a'],aguardando:['Ainda não iniciado','']};
const enc=o=>btoa(unescape(encodeURIComponent(JSON.stringify(o))));
const dec=s=>JSON.parse(decodeURIComponent(escape(atob(String(s).trim()))));

/* ================= Estado ================= */
function vazio(){return{nome:'',ocultar:false,tarefas:[],contas:[],trans:[],orc:{'Alimentação & Mercado':900,'Moradia & Contas':850,'Lazer & Pessoal':400},metas:[],ideias:[],decisoes:[],compras:[]}}
function carregar(){
  try{
    const s=LS.getItem(KEY());
    if(s)return Object.assign(vazio(),JSON.parse(s));
    const o=LS.getItem('viva-mvp-v1');
    if(o){
      const x=JSON.parse(o),n=vazio();
      n.tarefas=(x.tarefas||[]).map(t=>({id:t.id,titulo:t.titulo,data:t.prazo||hoje(),hora:'',prio:t.prioridade||'media',cat:'Rotina',feito:!!t.feito}));
      (x.lembretes||[]).forEach(l=>n.tarefas.push({id:l.id,titulo:l.texto,data:l.data||hoje(),hora:l.hora||'',prio:'media',cat:'Rotina',feito:false}));
      n.contas=(x.contas||[]).map(c=>({id:c.id,desc:c.descricao,valor:+c.valor||0,venc:c.vencimento||hoje(),pago:!!c.pago}));
      n.metas=(x.metas||[]).map(m=>({id:m.id,nome:m.nome,alvo:m.alvo,atual:m.atual,passo:m.passo||1,din:/reserva|poupan|economi|guard|dinheiro/i.test(m.nome),unid:''}));
      n.ideias=x.ideias||[];n.decisoes=x.decisoes||[];
      return n;
    }
  }catch(e){}
  return vazio();
}
let state=vazio();
function salvar(){try{LS.setItem(KEY(),JSON.stringify(state))}catch(e){}}

/* ================= Estado de interface ================= */
let view='inicio',mes=hoje().slice(0,7),diaSel=0,filtro='Todas',seg='Metas',sheet=null,
    capModo='texto',capTxt='',capItems=null,gravando=false,ocultaPlan=false,zerarPend=false,
    authTab='entrar',adminTab='painel',adminEdit={},adminNota={};
const timer={titulo:'',left:0,iv:null,run:false};

/* ================= Regras de negócio ================= */
const guessCat=t=>/caminh|trein|corr|m[eé]dic|consulta|[aá]gua|medita|aca?demia|sa[uú]de|dormir/i.test(t)?'Bem-estar':/compra|casa|limp|feira|lavar|arrum/i.test(t)?'Casa':/conta|banco|cart[aã]o|pagar|pend[eê]ncia|boleto|fatura/i.test(t)?'Finanças':/reuni|trabalho|enviar|e-?mail|projeto|cliente/i.test(t)?'Trabalho':'Rotina';
const catDesp=t=>/mercado|feira|almo[cç]o|jantar|comida|restaurante|delivery|lanche|padaria|caf[eé]/i.test(t)?'Alimentação & Mercado':/luz|energia|[aá]gua|aluguel|internet|g[aá]s|condom[ií]nio|telefone|conta/i.test(t)?'Moradia & Contas':'Lazer & Pessoal';
const principal=()=>state.metas.find(m=>m.din)||state.metas[0];
const ordT=(a,b)=>{const x=a.data+(a.hora||'99:99'),y=b.data+(b.hora||'99:99');return x<y?-1:x>y?1:0};
const R=v=>state.ocultar?'R$ ••••':moeda(v);
function relConta(c){const d=diff(hoje(),c.venc);return d<0?['Vencida há '+(-d)+' dia(s)','red']:d===0?['Vence hoje','amber']:d===1?['Vence amanhã ('+fmtD(c.venc)+')','red']:['Vence em '+d+' dias ('+fmtD(c.venc)+')','']}
function pagarConta(c){if(c.pago)return;c.pago=true;state.trans.push({id:uid(),tipo:'despesa',desc:c.desc,valor:c.valor,data:hoje(),cat:catDesp(c.desc)})}
function guardar(v){
  let m=principal();
  if(!m||!m.din){m={id:uid(),nome:'Reserva de emergência',alvo:6000,atual:0,passo:50,din:true,unid:''};state.metas.unshift(m)}
  m.atual=Math.min(m.alvo,m.atual+v);
  state.trans.push({id:uid(),tipo:'economia',desc:m.nome,valor:v,data:hoje(),cat:'Reserva'});
}
function totaisMes(){
  const t=state.trans.filter(x=>x.data.startsWith(mes));
  const s=k=>t.filter(x=>x.tipo===k).reduce((a,x)=>a+x.valor,0);
  return{rec:s('receita'),desp:s('despesa'),eco:s('economia'),lista:t};
}
function gastoCat(c){return state.trans.filter(x=>x.tipo==='despesa'&&x.data.startsWith(mes)&&x.cat===c).reduce((a,x)=>a+x.valor,0)}
function avisos(){
  const a=[];
  state.contas.filter(c=>!c.pago&&diff(hoje(),c.venc)<=2).forEach(c=>a.push('💳 '+c.desc+': '+relConta(c)[0].toLowerCase()));
  state.tarefas.filter(t=>!t.feito&&t.prio==='alta'&&t.data<=hoje()).forEach(t=>a.push('❗ Tarefa urgente: '+t.titulo));
  Object.keys(state.orc).forEach(c=>{if(state.orc[c]>0&&gastoCat(c)>=state.orc[c])a.push('📊 Orçamento de '+c+' atingiu o limite')});
  return a;
}

/* ================= Captura inteligente (interpretador local) ================= */
const M='(\\d{1,3}(?:\\.\\d{3})+(?:,\\d+)?|\\d+(?:[.,]\\d+)?)';
const W='[a-zçãõáéíóúâêôà ]';
const pm=s=>{s=String(s);s=/^\d{1,3}(\.\d{3})+(,\d+)?$/.test(s)?s.replace(/\./g,'').replace(',','.'):s.replace(',','.');return parseFloat(s)||0};
const DATAW=/\b(hoje|amanhã|depois de amanhã|domingo|segunda|terça|quarta|quinta|sexta|sábado)(-feira)?\b|\bdia \d{1,2}\b/g;
function quando(t){
  let data='',hora='',r=t;
  const dias=['domingo','segunda','terça','quarta','quinta','sexta','sábado'];
  if(/depois de amanhã/.test(r)){data=addDias(2);r=r.replace(/depois de amanhã/,'')}
  else if(/amanhã/.test(r)){data=addDias(1);r=r.replace(/amanhã/,'')}
  else if(/\bhoje\b/.test(r)){data=hoje();r=r.replace(/\bhoje\b/,'')}
  else{
    const m=r.match(/(domingo|segunda|terça|quarta|quinta|sexta|sábado)(-feira)?/);
    if(m){const n=((dias.indexOf(m[1])-new Date().getDay()+7)%7)||7;data=addDias(n);r=r.replace(m[0],'')}
    else{const m2=r.match(/\bdia (\d{1,2})\b/);
      if(m2){const d=new Date();let dt=new Date(d.getFullYear(),d.getMonth(),+m2[1],12);if(ds(dt)<hoje())dt=new Date(d.getFullYear(),d.getMonth()+1,+m2[1],12);data=ds(dt);r=r.replace(m2[0],'')}}
  }
  const h=r.match(/(?:\bàs?\s*)?\b(\d{1,2})(?::(\d{2})|h(\d{2})?|\s*horas?)(?![a-z])/);
  if(h&&+h[1]<24){hora=p2(+h[1])+':'+(h[2]||h[3]||'00');r=r.replace(h[0],'')}
  return{data,hora,resto:r.replace(/\s+/g,' ').replace(/^(de|que|para)\s+/,'').trim()};
}
function interpretar(txt){
  const out=[];
  txt.split(/\n|;|\.(?=\s|$)/).map(s=>s.trim()).filter(Boolean).forEach(raw=>{
    const s=raw.toLowerCase().replace(/[“”"]/g,'');
    let hit=false,m,rec=0,sav=0,bill=0;
    if(m=s.match(new RegExp('receb\\w*\\s+(?:r\\$\\s*)?'+M))){rec=pm(m[1]);out.push({k:'receita',desc:'Receita',valor:rec});hit=true}
    if(m=s.match(new RegExp('(?:guardar|poupar|economizar|reservar)\\s+(?:r\\$\\s*)?'+M))){sav=pm(m[1]);out.push({k:'economia',desc:'Reserva Financeira',valor:sav});hit=true}
    if(m=s.match(new RegExp('pagar\\s+(?:r\\$\\s*)?'+M+'\\s*(?:reais)?\\s*(?:de|da|do|em)\\s+(?:uma?\\s+)?(?:conta\\s+(?:de\\s+|da\\s+|do\\s+)?)?('+W+'+?)(?=\\s+e\\s|,|$)'))){
      bill=pm(m[1]);const q=quando(s);
      const nm=m[2].replace(DATAW,'').replace(/\s+/g,' ').trim()||'conta';
      out.push({k:'conta',desc:'Conta de '+nm,valor:bill,venc:q.data||hoje()});hit=true}
    if(m=s.match(new RegExp('(?:usar|gastar)\\s+o\\s+restante\\s+(?:no|na|em|com|nos|nas)\\s+('+W+'+)'))){
      const resto=rec-sav-bill;
      if(resto>0)out.push({k:'despesa',desc:cap(m[1]),valor:resto});hit=true}
    if(m=s.match(new RegExp('(?:gastei|paguei|comprei)\\s+(?:r\\$\\s*)?'+M+'\\s*(?:reais)?\\s*(?:no|na|em|de|com|num|numa)?\\s*('+W+'+)?'))){
      out.push({k:'despesa',desc:cap((m[2]||'Gasto').replace(/\b(hoje|ontem)\b/g,'').trim())||'Gasto',valor:pm(m[1])});hit=true}
    if(hit)return;
    if(m=s.match(/(\d+)\s*x\s*(?:na|por|a)\s*semana/)){
      out.push({k:'meta',nome:cap(s.replace(m[0],'').replace(/\s+/g,' ').trim()),alvo:+m[1],unid:'vezes/semana'});return}
    if(m=s.match(/compr(?:ar|e)\s+(.+)/)){
      const itens=m[1].split(/,|\se\s/).map(x=>cap(x.replace(/\b(hoje|amanhã)\b/g,'').trim())).filter(Boolean);
      if(itens.length){out.push({k:'compras',itens});return}}
    const q=quando(s.replace(/^(?:lembrar|lembre-me|lembrete)\s*(?:de|para)?\s*/,''));
    const titulo=cap(q.resto)||cap(raw);
    out.push({k:'tarefa',titulo,data:q.data||hoje(),hora:q.hora,prio:/urgente|pend[eê]ncia|prioridade/.test(s)?'alta':'media',cat:guessCat(s)});
  });
  return out;
}
function aplicar(items){
  items.forEach(i=>{
    const id=uid();
    if(i.k==='receita')state.trans.push({id,tipo:'receita',desc:i.desc,valor:i.valor,data:hoje(),cat:'Receita'});
    else if(i.k==='despesa')state.trans.push({id,tipo:'despesa',desc:i.desc,valor:i.valor,data:hoje(),cat:catDesp(i.desc)});
    else if(i.k==='economia')guardar(i.valor);
    else if(i.k==='conta')state.contas.push({id,desc:i.desc,valor:i.valor,venc:i.venc,pago:false});
    else if(i.k==='tarefa')state.tarefas.push({id,titulo:i.titulo,data:i.data,hora:i.hora,prio:i.prio,cat:i.cat,feito:false});
    else if(i.k==='compras')i.itens.forEach(x=>state.compras.push({id:uid(),item:x,ok:false}));
    else if(i.k==='meta')state.metas.push({id,nome:i.nome,alvo:i.alvo,atual:0,passo:1,din:false,unid:i.unid});
  });
}
