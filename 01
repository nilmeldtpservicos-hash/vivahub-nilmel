function tresAcoes(){
  const pend=state.tarefas.filter(t=>!t.feito).sort(ordT);
  const bills=state.contas.filter(c=>!c.pago&&diff(hoje(),c.venc)<=2).sort((a,b)=>a.venc<b.venc?-1:1);
  let u=null;
  if(bills[0])u={tipo:'conta',id:bills[0].id,t:bills[0].desc+' · '+moeda(bills[0].valor),n:relConta(bills[0])[0]+'. Evita cobrança ou atraso.'};
  else{const t=pend.find(t=>t.prio==='alta')||pend[0];if(t)u={tipo:'tarefa',id:t.id,t:t.titulo,n:'Levará ~20 min. Evita acúmulo.'}}
  const usados=[u&&u.id];
  let q=null;const ab=state.compras.filter(c=>!c.ok);
  if(ab.length)q={tipo:'compras',t:'Confirmar lista de compras',n:'Apenas 3 minutos · '+ab.length+' itens anotados.'};
  else{const t=pend.find(t=>!usados.includes(t.id)&&t.prio==='baixa')||pend.find(t=>!usados.includes(t.id));if(t){q={tipo:'tarefa',id:t.id,t:t.titulo,n:'Rápida · cerca de 5 min.'};usados.push(t.id)}}
  let i=null;const w=pend.find(t=>t.cat==='Bem-estar'&&!usados.includes(t.id));
  if(w)i={tipo:'tarefa',id:w.id,t:w.titulo,n:'Sua saúde e relaxamento mental.'};
  else{const m=principal();if(m)i={tipo:'meta',id:m.id,t:'Avançar na meta: '+m.nome,n:'Um pequeno passo de '+(m.din?moeda(m.passo):nfmt(m.passo))+' já conta.'}}
  const mostradas=[u,q,i].filter(Boolean).length;
  return{u,q,i,ocultas:Math.max(0,pend.length+state.contas.filter(c=>!c.pago).length-mostradas)};
}
