/* ================= Sessão ================= */
function entrarComo(u){
  sess=u.login;LS.setItem(SKEY,sess);
  const tem=LS.getItem(KEY());
  if(!tem){
    let leg=null;try{leg=JSON.parse(LS.getItem('viva-v2')||'null')}catch(e){}
    state=leg?Object.assign(vazio(),leg):vazio();
  }else state=carregar();
  state.nome=(u.nome||'').split(' ')[0]||u.nome||'';
  salvar();
  if(!u.visto){const U=uLoad();if(U[u.login]){U[u.login].visto=true;uSave(U)}view='guia'}else view='inicio';
  sheet=null;render();window.scrollTo(0,0);
}

