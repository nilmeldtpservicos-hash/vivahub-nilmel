  adiarNE:()=>mutar(()=>{let n=0;state.tarefas.forEach(t=>{if(!t.feito&&t.data===hoje()&&t.prio!=='alta'){t.data=addDias(1);n++}});toast(n?n+' tarefa(s) adiadas para amanhã':'Nada a adiar: só restam as essenciais')}),
  dividirMeta:()=>mutar(()=>{const m=state.metas.filter(x=>x.atual<x.alvo).sort((a,b)=>(b.alvo-b.atual)-(a.alvo-a.atual))[0];if(!m){toast('Crie uma meta primeiro');return}
    ['Definir o primeiro passo','Reservar um horário na agenda','Dar o primeiro avanço'].forEach((p,i)=>state.tarefas.push({id:uid(),titulo:m.nome+': '+p,data:addDias(i),hora:'',prio:'media',cat:'Rotina',feito:false}));toast('Meta dividida em 3 passos')}),
  seed:()=>mutar(()=>{exemplos();sheet=null;toast('Exemplos carregados')}),
  zerar:()=>{if(!zerarPend){zerarPend=true;render();return}state=vazio();zerarPend=false;salvar();sheet=null;render()}
};
document.addEventListener('click',e=>{
  const g=e.target.closest('[data-go]');if(g){go(g.dataset.go);return}
  const a=e.target.closest('[data-act]');if(!a)return;
  if(a.dataset.act==='fecharBg'&&e.target!==a)return;
  const f=A[a.dataset.act];if(f)f(a.dataset,a,e);
});
document.addEventListener('input',e=>{if(e.target.id==='captxt')capTxt=e.target.value});

const F={
  login:d=>{
    const login=slug(d.login),senha=String(d.senha||'');
    if(!login){toast('Informe seu usuário');return'noRender'}
    if(!senha){toast('Informe a senha');return'noRender'}
    if(login==='admin'){
      if(senha!==admPw()){toast('Senha do administrador incorreta');return'noRender'}
      sess='admin';LS.setItem(SKEY,'admin');adminTab='painel';sheet=null;render();window.scrollTo(0,0);return'noRender';
    }
    const U=uLoad(),u=U[login];
    if(!u){toast('Usuário não encontrado. Peça o acesso ao administrador.');return'noRender'}
    if(u.senha!==senha){toast('Senha incorreta');return'noRender'}
    const st=statusUser(u);
    if(st==='bloqueado'){toast('Acesso bloqueado pelo administrador');return'noRender'}
    if(st==='expirado'){toast('Seu período de uso terminou em '+fmtD(u.fim));return'noRender'}
    if(st==='aguardando'){toast('Seu acesso começa em '+fmtD(u.ini));return'noRender'}
    entrarComo(u);return'noRender';
  },
  codigo:d=>{
    let o;try{o=dec(d.cod)}catch(e){toast('Código inválido. Copie o código completo.');return'noRender'}
    if(!o||!o.l||!o.s||!o.n||slug(o.l)==='admin'){toast('Código inválido.');return'noRender'}
    const U=uLoad(),ant=U[o.l]||{};
    U[o.l]=Object.assign({criado:hoje(),visto:false,nota:''},ant,{nome:o.n,login:o.l,senha:o.s,ini:o.i,fim:o.f,bloqueado:!!o.b});
    uSave(U);
    return F.login({login:o.l,senha:o.s});
  },
  admNovo:d=>{
    const nome=String(d.nome||'').trim(),login=slug(nome),senha=String(d.senha||'');
    if(nome.length<3){toast('Informe o nome completo');return'noRender'}
    if(login==='admin'){toast('Este nome é reservado');return'noRender'}
    const U=uLoad();
    if(U[login]){toast('Já existe um acesso com esse nome');return'noRender'}
    if(senha.length<4){toast('A senha precisa ter 4 caracteres ou mais');return'noRender'}
    const ini=d.ini||hoje(),fim=d.fim||addDias(30);
    if(fim<ini){toast('A data final deve ser depois do início');return'noRender'}
    U[login]={nome,login,senha,ini,fim,bloqueado:false,criado:hoje(),visto:false,nota:''};
    uSave(U);adminTab='usuarios';render();toast('Acesso criado para '+nome+' — login: '+login);return'noRender';
  },
  admPeriodo:d=>{const U=uLoad(),u=U[d.login];if(u){u.ini=d.ini||u.ini;u.fim=d.fim||u.fim;uSave(U)}delete adminEdit[d.login];render();toast('Período atualizado');return'noRender'},
  admNota:d=>{const U=uLoad(),u=U[d.login];if(u){u.nota=String(d.nota||'').trim();uSave(U)}delete adminNota[d.login];render();toast('Anotação salva');return'noRender'},
  tarefa:d=>{state.tarefas.push({id:uid(),titulo:d.titulo.trim(),data:d.data||hoje(),hora:d.hora||'',prio:d.prio,cat:d.cat,feito:false});sheet=null},
  trans:d=>{state.trans.push({id:uid(),tipo:d.tipo,desc:d.desc.trim(),valor:Math.abs(parseFloat(d.valor)||0),data:d.data||hoje(),cat:d.tipo==='receita'?'Receita':catDesp(d.desc)});mes=(d.data||hoje()).slice(0,7);sheet=null},
  conta:d=>{state.contas.push({id:uid(),desc:d.desc.trim(),valor:parseFloat(d.valor)||0,venc:d.venc||hoje(),pago:false});sheet=null},
  meta:d=>{state.metas.push({id:uid(),nome:d.nome.trim(),alvo:Math.max(1,parseFloat(d.alvo)||1),atual:Math.max(0,parseFloat(d.atual)||0),passo:Math.max(.01,parseFloat(d.passo)||1),din:!!d.din,unid:''});sheet=null},
  orc:d=>{state.orc[d.c]=Math.max(0,parseFloat(d.v)||0);sheet=null},
  compra:d=>{state.compras.push({id:uid(),item:cap(d.item),ok:false})},
  ideia:d=>{state.ideias.push({id:uid(),texto:d.texto.trim(),categoria:'Outro'})},
  decisao:d=>{state.decisoes.push({id:uid(),titulo:d.titulo.trim(),pros:d.pros||'',contras:d.contras||'',status:'pendente',escolha:''})},
  decidir:d=>{const x=state.decisoes.find(y=>y.id===d.id);if(x){x.escolha=d.escolha.trim();x.status='decidida'}},
  nome:d=>{state.nome=d.nome.trim()||'Você';sheet=null},
  importar:d=>{try{const o=JSON.parse(d.json),n=vazio();Object.keys(n).forEach(k=>{if(o[k]!==undefined&&typeof o[k]===typeof n[k])n[k]=o[k]});state=n;sheet=null;toast('Backup restaurado')}catch(e){toast('Backup inválido. Confira o texto colado.')}},
  calc:d=>{
    let v=parseFloat(d.ini)||0;const a=parseFloat(d.apo)||0,i=(parseFloat(d.tx)||0)/100,n=Math.max(0,parseInt(d.ms)||0);let inv=v;
    for(let k=0;k<n;k++){v=v*(1+i)+a;inv+=a}
    const r=$('#calcres');if(r)r.innerHTML=`Em <b>${n} meses</b> você teria <b>${moeda(v)}</b>.<br><span class="muted">Total investido: ${moeda(inv)} · Rendimento: ${moeda(v-inv)}</span>`;
    return'noRender';
  }
};
document.addEventListener('submit',e=>{
  const f=e.target.closest('form[data-form]');if(!f)return;
  e.preventDefault();
  const fd=Object.fromEntries(new FormData(f));
  const r=F[f.dataset.form](fd);
  if(r==='noRender')return;
  salvar();render();
});
window.addEventListener('pagehide',()=>{tmStop()});

/* ================= Boot ================= */
(function boot(){
  const U=uLoad();let mudou=false;
  Object.keys(U).forEach(k=>{if(U[k].pendente){delete U[k].pendente;mudou=true}});
  if(mudou)uSave(U);
  if(sess&&sess!=='admin'){
    const u=U[sess];
    if(!u||statusUser(u)!=='ativo'){sess=null;LS.removeItem(SKEY);authTab='entrar'}
    else state=carregar();
  }
  render();
})();
</script>
