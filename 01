const fmtT=s=>p2(Math.floor(s/60))+':'+p2(s%60);

/* ================= Render ================= */
function render(){
  if(sess&&sess!=='admin'){
    const u=uLoad()[sess],st=statusUser(u);
    if(st!=='ativo'){
      const msg=st==='bloqueado'?'Acesso bloqueado pelo administrador':st==='expirado'?'Seu período de uso terminou':'Acesso indisponível';
      tmStop();sess=null;LS.removeItem(SKEY);state=vazio();sheet=null;authTab='entrar';toast(msg);
    }
  }
  if(!sess){authTab==='guia'?renderGuia(true):renderAuth();return}
  if(sess==='admin'){renderAdmin();return}
  const bell=avisos().length;
  const V={inicio:vInicio,rotina:vRotina,captura:vCaptura,financas:vFinancas,metas:vMetas,perdido:vPerdido,guia:vGuia};
  const nav=[['inicio','🏠','Início'],['rotina','✅','Rotina'],['captura','✨','Captura'],['financas','👛','Finanças'],['metas','🎯','Metas & IA']];
  $('#app').innerHTML=`
  <div class="top"><span class="logo">VIVA</span><span class="chip">Life Hub</span><span class="sp"></span>
    <button class="ib" data-act="guia" aria-label="Como funciona">📖</button>
    <button class="ib" data-act="abrir" data-t="avisos" aria-label="Avisos">🔔${bell?`<span class="dot">${bell}</span>`:''}</button>
    <button class="ib av" data-act="abrir" data-t="config" aria-label="Perfil">${esc((state.nome||'V')[0].toUpperCase())}</button></div>
  <main>${(V[view]||vInicio)()}</main>
  <nav>${nav.map(([k,i,l])=>`<button class="${k==='captura'?'fab ':''}${view===k?'on':''}" data-go="${k}"><span>${i}</span>${l}</button>`).join('')}</nav>
  ${sheetHtml()}`;
}
function vGuia(){return`<button class="link" data-go="inicio">‹ Voltar</button>`+renderGuiaInline()}
function renderGuiaInline(){return`<h1 style="margin-top:8px">Como o VIVA funciona</h1><p class="sub">Tour rápido pelas áreas do app.</p>`+guiaCards(false)+`<button class="btn block" data-go="inicio" style="margin-bottom:20px">Começar a usar</button>`}
function go(v){view=v;sheet=null;render();window.scrollTo(0,0)}
function mutar(fn){fn();salvar();render()}

/* ================= Temporizador ================= */
function tmStop(){clearInterval(timer.iv);timer.iv=null;timer.run=false}
function tmTick(){
  timer.left--;
  const e=$('#tm');if(e)e.textContent=timer.left>0?fmtT(timer.left):'Tempo! 🎉';
  if(timer.left<=0){tmStop();timer.left=0;const b=$('#tmb');if(b)b.textContent='Iniciar';toast('Tempo concluído! 🎉')}
}

/* ================= Voz ================= */
function gravarVoz(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){toast('Reconhecimento de voz indisponível aqui. Use o modo Texto.');capModo='texto';render();return}
  try{
    const r=new SR();r.lang='pt-BR';r.interimResults=false;
    r.onresult=e=>{capTxt=e.results[0][0].transcript;capItems=interpretar(capTxt);gravando=false;render()};
    r.onerror=()=>{gravando=false;toast('Não consegui acessar o microfone. Use o modo Texto.');capModo='texto';render()};
    r.onend=()=>{if(gravando){gravando=false;render()}};
    gravando=true;render();r.start();
  }catch(e){gravando=false;toast('Microfone indisponível. Use o modo Texto.');capModo='texto';render()}
}

